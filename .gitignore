# Environment / secrets
.env
.env.local
.env.*.local

# Claude Code (configuración local del IDE)
.claude/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Salidas del arnés (capturas, volcados JSON, logs de corrida). Son
# REGENERABLES: cualquier modo de scripts/diagDSK.mjs las vuelve a escribir.
# Se ignoran porque llegaron a pesar 101 MB sin rastrear, a un `git add -A`
# distraído del desastre. La carpeta NO se borra nunca: el arnés escribe en
# ella con writeFileSync y sin mkdirSync, así que sin el directorio revienta.
# `evidencia/` es la excepción y por eso se re-incluye: guarda capturas
# tomadas contra código que ya no está en el árbol —sostienen el
# "byte-idéntico" de 8da6a89— y ésas no se regeneran sin repetir el stash.
capturas-dsk/*
!capturas-dsk/evidencia/
!capturas-dsk/evidencia/**

# Salidas del arnés de identidad (scripts/verifyIDN1.mjs). Mismo criterio que
# capturas-dsk, con un motivo MÁS fuerte para conservar `evidencia/`: IDN-1 es
# una campaña de sustitución visual, y el "antes" de una sustitución no se
# regenera sin volver a hacer stash del árbol. Ahí viven los dos JSON de cifras
# y los recortes por contexto. `f2/` queda fuera: es el estado intermedio
# (moneda sí, wordmark no) y se reconstruye stasheando los archivos de F3.
# Los recortes `-tarjeta` también quedan fuera: pesan lo que tres wordmarks y
# no dicen nada que el recorte del título no diga mejor — el Δ=0 de
# `.welcome-card` es una cifra del JSON, no hace falta la foto.
capturas-idn1/*
!capturas-idn1/evidencia/
!capturas-idn1/evidencia/**
capturas-idn1/evidencia/**/*-tarjeta.png

# Salidas de las sondas efímeras de la campaña VIS (scripts/screenshots/). Mismo
# criterio que las dos de arriba: son REGENERABLES —cualquier corrida del modo
# o de la sonda las vuelve a escribir— y ya iban por 16 PNG sin rastrear cuando
# VIS-1 las contó. La carpeta NO se borra: las sondas escriben con writeFileSync
# y sin mkdirSync, así que sin el directorio revientan.
scripts/screenshots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Salidas del arnés de renombre (scripts/verifyREN1.mjs). Aquí NO hay excepción
# `evidencia/`: a diferencia de IDN-1, el "antes" no exige stashear el árbol —la
# sonda sustituye la palabra en caliente en el MISMO elemento y mide las dos
# versiones en la misma corrida—, así que todo lo que hay dentro es regenerable
# con un `node scripts/verifyREN1.mjs`. La carpeta se crea sola (mkdirSync).
capturas-ren1/
