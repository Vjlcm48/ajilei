# Copiar este archivo como .env.local y pegar los valores reales del panel de Supabase.
# .env.local está ignorado por git y JAMÁS se commitea.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SUP-2b · Bypass de la puerta de entrada, SÓLO PARA DESARROLLO.
# Con `VITE_AUTH_BYPASS=1` la app arranca directo en la Bienvenida con un perfil
# ficticio local ("DevLocal"), sin tocar la red ni la sesión real. Es lo que deja
# intactos a los 20 arneses de scripts/, que dan por hecho que el primer render
# es la Bienvenida y que su primer clic es "Jugar vs IA".
# Puerta DOBLE, molde de src/dev/siembraCEL.js: la rama exige `import.meta.env.DEV`
# verdadero Y esta variable presente, así que en `vite build` no existe.
# Vacío o ausente = puerta viva, que es el comportamiento real del producto.
VITE_AUTH_BYPASS=
